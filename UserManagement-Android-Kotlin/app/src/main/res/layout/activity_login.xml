<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sh_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- LOGO UCOMPENSAR -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_ucompensar"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp" />

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card">

            <!-- CARD TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:letterSpacing="-0.02" />

            <!-- CARD DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_description"
                android:textSize="14sp"
                android:textColor="@color/sh_muted_foreground"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <!-- LABEL CORREO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginBottom="8dp" />

            <!-- INPUT CORREO -->
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="nombre@correo.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:textColorHint="@color/sh_muted_foreground"
                android:importantForAutofill="no" />

            <!-- LABEL CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- INPUT CONTRASEÑA -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:textColorHint="@color/sh_muted_foreground"
                android:importantForAutofill="no" />

            <!-- BOTÓN INGRESAR (default) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sign_in"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_primary_foreground"
                app:backgroundTint="#FF8000"
                app:cornerRadius="8dp" />

            <!-- BOTÓN CREAR CUENTA (outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearCuenta"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/create_account"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/sh_border"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <!-- MENSAJE -->
            <TextView
                android:id="@+id/tvMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/sh_destructive"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>