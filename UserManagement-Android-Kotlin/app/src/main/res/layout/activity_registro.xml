<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="@color/sh_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="50dp"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_ucompensar" />

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_description"
                android:textSize="14sp"
                android:textColor="@color/sh_muted_foreground"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:inputType="textPersonName"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/surname"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etApellido"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:inputType="textPersonName"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCorreoRegistro"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="nombre@correo.com"
                android:inputType="textEmailAddress"
                android:maxLength="150"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:textColorHint="@color/sh_muted_foreground"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:textColorHint="@color/sh_muted_foreground"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/birth_date"
                android:labelFor="@id/btnFechaNacimiento"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFechaNacimiento"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="start|center_vertical"
                android:text="@string/select_birth_date"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/sh_border"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvEdadCalculada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:textSize="13sp"
                android:textColor="@color/sh_muted_foreground"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/university"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etUniversidad"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:inputType="textCapWords"
                android:maxLength="250"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:textColor="@color/sh_foreground"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/semester"
                android:labelFor="@id/spSemestre"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_foreground"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spSemestre"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_select"
                android:paddingStart="4dp"
                android:paddingEnd="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/register"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sh_primary_foreground"
                app:backgroundTint="#FF8000"
                app:cornerRadius="8dp" />

            <!-- MENSAJE -->
            <TextView
                android:id="@+id/tvMensajeRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/sh_destructive"
                android:accessibilityLiveRegion="polite"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>